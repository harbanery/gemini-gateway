# ===============================================
# Copy file ini jadi ".env" untuk local dev.
# Untuk Vercel: set nilai ini di Dashboard ->
# Project -> Settings -> Environment Variables.
# Catatan: isi nilai saja, tanpa komentar di baris yang sama.
# ===============================================

# WAJIB - API key Gemini Anda
# Ambil dari: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# OPSIONAL (tapi disarankan) - kunci tambahan untuk memproteksi gateway
# agar tidak dipakai orang lain yang tahu URL Anda.
# Jika diisi, setiap request harus menyertakan header: x-proxy-key: <nilai ini>
# Jika dikosongkan, gateway terbuka untuk siapa saja yang tahu URL-nya.
PROXY_KEY=

# Hanya untuk local dev - di Vercel tidak dipakai (otomatis).
PORT=3000
